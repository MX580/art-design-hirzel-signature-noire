---
/**
 * Petit set d'icônes maison (traits, 24x24) — évite une dépendance externe
 * pour une poignée de pictogrammes. `name` détermine le tracé affiché.
 */
interface Props {
  name:
    | 'menu' | 'close' | 'arrow-right' | 'arrow-down' | 'chevron-down'
    | 'mail' | 'phone' | 'map-pin' | 'instagram' | 'external-link'
    | 'flame' | 'layers' | 'sparkles' | 'table' | 'board' | 'cabinet'
    | 'check' | 'alert';
  class?: string;
  strokeWidth?: number;
  id?: string;
}

const { name, class: className = 'w-6 h-6', strokeWidth = 1.3, id } = Astro.props;
---

<svg
  id={id}
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="butt"
  stroke-linejoin="miter"
  aria-hidden="true"
>
  {name === 'menu' && (
    <>
      <line x1="4" y1="7" x2="20" y2="7" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="17" x2="20" y2="17" />
    </>
  )}
  {name === 'close' && (
    <>
      <line x1="6" y1="6" x2="18" y2="18" />
      <line x1="18" y1="6" x2="6" y2="18" />
    </>
  )}
  {name === 'arrow-right' && (
    <>
      <line x1="4" y1="12" x2="20" y2="12" />
      <polyline points="13 5 20 12 13 19" />
    </>
  )}
  {name === 'arrow-down' && (
    <>
      <line x1="12" y1="4" x2="12" y2="20" />
      <polyline points="5 13 12 20 19 13" />
    </>
  )}
  {name === 'chevron-down' && <polyline points="6 9 12 15 18 9" />}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="3" />
      <path d="M4 7l8 6 8-6" />
    </>
  )}
  {name === 'phone' && (
    <path d="M6.6 3h3l1.4 4.4-2.1 2a13 13 0 0 0 6.1 6.1l2-2.1L21.4 15v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.2 2 2 0 0 1 6.6 3z" />
  )}
  {name === 'map-pin' && (
    <>
      <path d="M12 21s7-7.4 7-12a7 7 0 1 0-14 0c0 4.6 7 12 7 12z" />
      <circle cx="12" cy="9" r="2.4" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5.5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'external-link' && (
    <>
      <path d="M14 4h6v6" />
      <line x1="20" y1="4" x2="11" y2="13" />
      <path d="M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4" />
    </>
  )}
  {name === 'flame' && (
    <path d="M12 22a7 7 0 0 0 7-7c0-4-3-6-4-9-.5 2-2 3-2 5a3 3 0 0 1-3-3c-2 2-3 4-3 7a5 5 0 0 0 5 5z" />
  )}
  {name === 'layers' && (
    <>
      <polygon points="12 3 21 8.5 12 14 3 8.5 12 3" />
      <polyline points="3 14.5 12 20 21 14.5" />
    </>
  )}
  {name === 'sparkles' && (
    <>
      <path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z" />
      <path d="M19 15l.7 2.1 2.1.7-2.1.9-.7 2.1-.7-2.1-2.1-.9 2.1-.7z" />
    </>
  )}
  {name === 'table' && (
    <>
      <rect x="3" y="6" width="18" height="3" rx="1" />
      <line x1="6.5" y1="9" x2="6.5" y2="19" />
      <line x1="17.5" y1="9" x2="17.5" y2="19" />
    </>
  )}
  {name === 'board' && (
    <>
      <rect x="6" y="3" width="12" height="18" rx="6" />
      <circle cx="12" cy="7.2" r="1.2" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'cabinet' && (
    <>
      <rect x="4" y="3" width="16" height="18" rx="2" />
      <line x1="12" y1="3" x2="12" y2="21" />
      <circle cx="9.6" cy="12" r="0.7" fill="currentColor" stroke="none" />
      <circle cx="14.4" cy="12" r="0.7" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'check' && <polyline points="5 13 9 17 19 7" />}
  {name === 'alert' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <line x1="12" y1="8" x2="12" y2="13" />
      <circle cx="12" cy="16.2" r="0.7" fill="currentColor" stroke="none" />
    </>
  )}
</svg>
