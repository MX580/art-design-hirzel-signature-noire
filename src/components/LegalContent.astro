---
interface LegalSection {
  heading: string;
  body: readonly string[];
}

interface Props {
  title: string;
  updated: string;
  intro: string;
  sections: readonly LegalSection[];
}

const { title, updated, intro, sections } = Astro.props;

const updatedDate = new Date('2026-08-19').toLocaleDateString(
  Astro.currentLocale === 'en' ? 'en-CH' : 'fr-CH',
  { year: 'numeric', month: 'long', day: 'numeric' }
);
---

<section class="mx-auto max-w-[900px] px-5 py-16 sm:px-8 sm:py-20">
  <h1 class="font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{title}</h1>
  <p class="mt-2 text-sm text-ink-faint">{updated} {updatedDate}</p>
  <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft">{intro}</p>

  <div class="mt-10 border-t border-ink">
    {sections.map((section, i) => (
      <div class="grid gap-2 border-b border-border py-7 sm:grid-cols-[10rem_1fr] sm:gap-8">
        <h2 class="flex items-baseline gap-3 font-display text-base font-bold text-ink">
          <span class="font-mono text-xs font-normal text-copper">{String(i + 1).padStart(2, '0')}</span>
          {section.heading}
        </h2>
        <div class="space-y-2 text-sm leading-relaxed text-ink-soft">
          {section.body.map((line) => (
            <p>{line}</p>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
