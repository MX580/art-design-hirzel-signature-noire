---
interface LegalSection {
  heading: string;
  body: readonly string[];
}

interface Props {
  title: string;
  updated: string;
  intro: string;
  sections: readonly LegalSection[];
}

const { title, updated, intro, sections } = Astro.props;

const updatedDate = new Date('2026-08-19').toLocaleDateString(
  Astro.currentLocale === 'en' ? 'en-CH' : 'fr-CH',
  { year: 'numeric', month: 'long', day: 'numeric' }
);
---

<section class="mx-auto max-w-[900px] px-6 pt-36 pb-24 sm:px-10 sm:pt-44 sm:pb-32">
  <h1 class="font-display text-3xl font-medium tracking-[-0.03em] text-paper sm:text-5xl">{title}</h1>
  <p class="mt-4 text-[0.6rem] font-medium tracked text-copper">{updated} {updatedDate}</p>
  <p class="mt-8 max-w-2xl text-base leading-relaxed text-paper/60">{intro}</p>

  <div class="mt-14">
    {sections.map((section, i) => (
      <div class="grid gap-3 border-t border-white/10 py-8 last:border-b sm:grid-cols-[11rem_1fr] sm:gap-10">
        <h2 class="flex items-baseline gap-3 font-display text-sm font-medium text-paper">
          <span class="text-[0.55rem] tracked text-copper">{String(i + 1).padStart(2, '0')}</span>
          {section.heading}
        </h2>
        <div class="space-y-2 text-sm leading-relaxed text-paper/55">
          {section.body.map((line) => (
            <p>{line}</p>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
