---
import { Image } from 'astro:assets';
import atelier from '../assets/about/atelier-large.jpg';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const about = t('about');
---

<section id="a-propos" class="scroll-mt-24 bg-black">
  <div class="mx-auto max-w-[1600px] px-6 py-24 sm:px-10 sm:py-32">
    <div class="flex items-center gap-4">
      <span class="h-px w-12 bg-copper" aria-hidden="true"></span>
      <span class="text-[0.6rem] font-medium tracked text-copper-light">02 — {about.kicker}</span>
    </div>

    <div class="mt-12 grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 class="font-display text-3xl leading-[1.02] font-medium tracking-[-0.03em] text-paper sm:text-5xl">
          {about.title}
        </h2>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div class="space-y-6 text-base leading-[1.85] text-paper/65">
          {about.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Bandeau plein cadre : photographie de l'atelier -->
  <div class="relative h-[55vh] min-h-[380px] w-full overflow-hidden">
    <Image
      src={atelier}
      alt={about.imageAlt}
      class="h-full w-full object-cover"
      width={1800}
      height={1000}
    />
    <div class="absolute inset-0 bg-black/35" aria-hidden="true"></div>
  </div>

  <!-- Chiffres clés, façon fiche technique -->
  <div class="mx-auto max-w-[1600px] px-6 sm:px-10">
    <dl class="grid grid-cols-2 border-b border-white/10 lg:grid-cols-4">
      {about.facts.map((fact, i) => (
        <div
          class:list={[
            'border-t border-white/10 px-2 py-10 sm:py-14',
            i % 2 === 1 ? 'border-l pl-6' : '',
            i > 1 ? 'lg:border-l lg:pl-6' : '',
            i === 1 ? 'lg:border-l' : '',
          ]}
        >
          <dt class="text-[0.6rem] font-medium tracked text-copper">{fact.label}</dt>
          <dd class="mt-4 font-display text-lg leading-tight font-medium tracking-tight text-paper sm:text-2xl">
            {fact.value}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
