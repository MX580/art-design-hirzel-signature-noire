---
import { Image } from 'astro:assets';
import atelier from '../assets/about/atelier-large.jpg';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const about = t('about');
---

<section id="a-propos" class="scroll-mt-24 border-b border-ink">
  <div class="mx-auto grid max-w-[1400px] gap-10 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-4">
      <span class="text-xs font-semibold tracking-[0.14em] text-copper uppercase">02 — {about.kicker}</span>
      <h2 class="mt-3 font-display text-3xl leading-[1.02] font-extrabold tracking-tight text-ink sm:text-4xl">
        {about.title}
      </h2>

      <dl class="mt-10 divide-y divide-border border-t border-b border-border">
        {about.facts.map((fact) => (
          <div class="flex items-baseline justify-between gap-4 py-3.5">
            <dt class="text-xs font-semibold tracking-wide text-ink-faint uppercase">{fact.label}</dt>
            <dd class="text-right text-sm font-semibold text-ink">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="lg:col-span-4 lg:col-start-6">
      <div class="space-y-5 text-base leading-relaxed text-ink-soft">
        {about.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>

    <div class="lg:col-span-3 lg:col-start-10">
      <div class="relative aspect-[3/4] w-full overflow-hidden border border-ink">
        <Image src={atelier} alt={about.imageAlt} class="h-full w-full object-cover grayscale-[35%] contrast-[1.08]" width={560} height={745} />
      </div>
    </div>
  </div>
</section>
