---
import { useTranslations, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const nav = t('nav');
const footer = t('footer');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = base + (lang === 'en' ? '/en' : '');
const legalHref = base + (lang === 'en' ? '/en/legal-notice' : '/mentions-legales');
const privacyHref = base + (lang === 'en' ? '/en/privacy-policy' : '/confidentialite');
const year = new Date().getFullYear();

const links = [
  { href: `${prefix}/#a-propos`, label: nav.about },
  { href: `${prefix}/#savoir-faire`, label: nav.skills },
  { href: `${prefix}/#realisations`, label: nav.gallery },
  { href: `${prefix}/#contact`, label: nav.contact },
];
---

<footer class="bg-cream">
  <div class="mx-auto max-w-[1400px] px-5 py-14 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
      <div>
        <a href={`${prefix}/`} class="font-display text-lg font-extrabold tracking-tight text-ink">
          ART DESIGN <span class="font-normal text-ink-soft">BY HIRZEL</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-soft">{footer.tagline}</p>
      </div>

      <div>
        <p class="text-xs font-semibold tracking-[0.12em] text-ink-faint uppercase">{footer.nav}</p>
        <ul class="mt-4 space-y-2.5">
          {links.map((link) => (
            <li><a href={link.href} class="text-sm text-ink-soft transition hover:text-copper">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold tracking-[0.12em] text-ink-faint uppercase">{footer.legal}</p>
        <ul class="mt-4 space-y-2.5">
          <li><a href={legalHref} class="text-sm text-ink-soft transition hover:text-copper">{footer.legalNotice}</a></li>
          <li><a href={privacyHref} class="text-sm text-ink-soft transition hover:text-copper">{footer.privacy}</a></li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold tracking-[0.12em] text-ink-faint uppercase">Instagram</p>
        <a
          href="https://www.instagram.com/artdesignbyhirzel/"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 flex items-center gap-2 text-sm text-ink-soft transition hover:text-copper"
        >
          <Icon name="instagram" class="h-4 w-4" />
          @artdesignbyhirzel
        </a>
      </div>
    </div>

    <div class="mt-12 flex flex-col-reverse items-center justify-between gap-4 border-t border-ink pt-6 sm:flex-row">
      <p class="text-xs text-ink-faint">© {year} Art Design by Hirzel. {footer.rights}</p>
      <a href="#top" class="text-xs font-semibold tracking-wide text-ink-soft uppercase transition hover:text-copper">{footer.backToTop} ↑</a>
    </div>
  </div>
</footer>
