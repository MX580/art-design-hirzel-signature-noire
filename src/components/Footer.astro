---
import { useTranslations, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const nav = t('nav');
const footer = t('footer');
const common = t('common');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = base + (lang === 'en' ? '/en' : '');
const legalHref = base + (lang === 'en' ? '/en/legal-notice' : '/mentions-legales');
const privacyHref = base + (lang === 'en' ? '/en/privacy-policy' : '/confidentialite');
const year = new Date().getFullYear();

const links = [
  { href: `${prefix}/#a-propos`, label: nav.about },
  { href: `${prefix}/#savoir-faire`, label: nav.skills },
  { href: `${prefix}/#realisations`, label: nav.gallery },
  { href: `${prefix}/#contact`, label: nav.contact },
];
---

<footer class="border-t border-white/10 bg-black">
  <div class="mx-auto max-w-[1600px] px-6 py-12 sm:px-10 sm:py-20">
    <a href={`${prefix}/`} class="font-display text-xl font-semibold tracking-[0.14em] text-paper uppercase sm:text-2xl">
      Art Design by Hirzel
    </a>

    <div class="mt-10 grid gap-10 sm:mt-14 sm:gap-12 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="max-w-xs text-sm leading-relaxed text-paper/50">{footer.tagline}</p>
      </div>

      <div>
        <p class="text-[0.55rem] font-medium tracked text-paper/35">{footer.nav}</p>
        <ul class="mt-6 space-y-3">
          {links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-paper/70 transition hover:text-copper-light">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-[0.55rem] font-medium tracked text-paper/35">{footer.legal}</p>
        <ul class="mt-6 space-y-3">
          <li><a href={legalHref} class="text-sm text-paper/70 transition hover:text-copper-light">{footer.legalNotice}</a></li>
          <li><a href={privacyHref} class="text-sm text-paper/70 transition hover:text-copper-light">{footer.privacy}</a></li>
        </ul>
      </div>

      <div>
        <p class="text-[0.55rem] font-medium tracked text-paper/35">Instagram</p>
        <a
          href="https://www.instagram.com/artdesignbyhirzel/"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-3 text-sm text-paper/70 transition hover:text-copper-light"
          aria-label={common.instagramNewTab}
        >
          <Icon name="instagram" class="h-4 w-4" />
          @artdesignbyhirzel
        </a>
      </div>
    </div>

    <div class="mt-12 flex flex-col-reverse gap-4 border-t border-white/10 pt-6 sm:mt-16 sm:pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-[0.65rem] text-paper/30">© {year} Art Design by Hirzel. {footer.rights}</p>
      <a href="#top" class="text-[0.55rem] font-medium tracked text-paper/50 transition hover:text-copper-light">
        {footer.backToTop}
      </a>
    </div>
  </div>
</footer>
