---
import { useTranslations, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const contact = t('contact');
const form = contact.form;
---

<section id="contact" class="scroll-mt-24 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-8">
      <!-- Carte coordonnées -->
      <div class="rounded-xl bg-steel p-8 text-cream shadow-soft sm:p-10">
        <span class="inline-flex items-center rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold tracking-wide text-copper-light uppercase">
          {contact.kicker}
        </span>
        <h2 class="mt-5 font-display text-3xl font-semibold sm:text-4xl">{contact.title}</h2>
        <p class="mt-4 text-sm leading-relaxed text-cream/75 sm:text-base">{contact.lead}</p>

        <ul class="mt-8 space-y-4">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-white/10 text-copper-light">
              <Icon name="mail" class="h-4.5 w-4.5" />
            </span>
            <div class="text-sm">
              <a href={`mailto:${contact.email}`} class="font-medium text-cream hover:text-copper-light">{contact.email}</a>
              <p class="text-xs text-cream/50">{contact.emailNote}</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-white/10 text-copper-light">
              <Icon name="phone" class="h-4.5 w-4.5" />
            </span>
            <div class="text-sm">
              <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="font-medium text-cream hover:text-copper-light">{contact.phone}</a>
              <p class="text-xs text-cream/50">{contact.phoneNote}</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-white/10 text-copper-light">
              <Icon name="map-pin" class="h-4.5 w-4.5" />
            </span>
            <div class="text-sm">
              <p class="font-medium text-cream">{contact.location}</p>
            </div>
          </li>
        </ul>

        <div class="mt-9 border-t border-white/10 pt-6">
          <p class="text-xs font-semibold tracking-wide text-cream/50 uppercase">{contact.social}</p>
          <a
            href="https://www.instagram.com/artdesignbyhirzel/"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2.5 text-sm font-medium text-cream transition hover:bg-copper hover:text-cream"
          >
            <Icon name="instagram" class="h-4 w-4" />
            @artdesignbyhirzel
          </a>
        </div>
      </div>

      <!-- Formulaire -->
      <div class="rounded-xl bg-surface p-8 shadow-card ring-1 ring-ink/5 sm:p-10">
        <form
          id="contact-form"
          novalidate
          data-i18n={JSON.stringify({
            submitting: form.submitting,
            submit: form.submit,
            success: form.success,
            error: form.error,
            errorValidation: form.errorValidation,
          })}
        >
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-1">
              <label for="name" class="text-sm font-medium text-ink">{form.name}</label>
              <input
                type="text" id="name" name="name" required autocomplete="name"
                placeholder={form.namePlaceholder}
                class="mt-1.5 w-full rounded-md border border-border bg-cream px-4 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-copper focus:ring-2 focus:ring-copper/20 focus:outline-none"
              />
            </div>
            <div class="sm:col-span-1">
              <label for="email" class="text-sm font-medium text-ink">{form.email}</label>
              <input
                type="email" id="email" name="email" required autocomplete="email"
                placeholder={form.emailPlaceholder}
                class="mt-1.5 w-full rounded-md border border-border bg-cream px-4 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-copper focus:ring-2 focus:ring-copper/20 focus:outline-none"
              />
            </div>
            <div class="sm:col-span-2">
              <label for="subject" class="text-sm font-medium text-ink">{form.subject}</label>
              <input
                type="text" id="subject" name="subject" autocomplete="off"
                placeholder={form.subjectPlaceholder}
                class="mt-1.5 w-full rounded-md border border-border bg-cream px-4 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-copper focus:ring-2 focus:ring-copper/20 focus:outline-none"
              />
            </div>
            <div class="sm:col-span-2">
              <label for="message" class="text-sm font-medium text-ink">{form.message}</label>
              <textarea
                id="message" name="message" required rows="5"
                placeholder={form.messagePlaceholder}
                class="mt-1.5 w-full resize-y rounded-md border border-border bg-cream px-4 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-copper focus:ring-2 focus:ring-copper/20 focus:outline-none"
              ></textarea>
            </div>
          </div>

          <!-- Piège à robots : champ invisible pour les humains, laissé vide -->
          <div class="hidden" aria-hidden="true">
            <label for="company">Company</label>
            <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="rendered_at" value="" id="rendered_at" />

          <label class="mt-5 flex items-start gap-2.5 text-xs text-ink-faint">
            <input type="checkbox" name="consent" required class="mt-0.5 h-4 w-4 shrink-0 rounded border-border text-copper focus:ring-copper/30" />
            <span>{form.consent}</span>
          </label>

          <div class="mt-6 flex flex-wrap items-center gap-4">
            <button
              type="submit"
              id="contact-submit"
              class="inline-flex items-center gap-2 rounded-full bg-copper px-6 py-3.5 text-sm font-semibold text-cream shadow-card transition hover:bg-copper-dark hover:shadow-card-hover disabled:cursor-not-allowed disabled:opacity-60"
            >
              <span id="contact-submit-label">{form.submit}</span>
            </button>
            <p id="contact-status" role="status" aria-live="polite" class="text-sm"></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const formEl = document.getElementById('contact-form');
  const statusEl = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit');
  const submitLabel = document.getElementById('contact-submit-label');
  const renderedAt = document.getElementById('rendered_at');

  const stampRenderedAt = () => {
    if (renderedAt instanceof HTMLInputElement) renderedAt.value = String(Date.now());
  };

  if (
    formEl instanceof HTMLFormElement &&
    statusEl &&
    submitBtn instanceof HTMLButtonElement &&
    submitLabel
  ) {
    const i18n = JSON.parse(formEl.dataset.i18n || '{}');
    stampRenderedAt();

    formEl.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!formEl.checkValidity()) {
        formEl.reportValidity();
        statusEl.textContent = i18n.errorValidation ?? '';
        statusEl.className = 'text-sm text-error';
        return;
      }

      submitBtn.disabled = true;
      submitLabel.textContent = i18n.submitting ?? '';
      statusEl.textContent = '';
      statusEl.className = 'text-sm text-ink-faint';

      try {
        const formData = new FormData(formEl);
        const response = await fetch('/api/contact.php', {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || 'request_failed');
        }

        statusEl.textContent = i18n.success ?? '';
        statusEl.className = 'text-sm text-success';
        formEl.reset();
        stampRenderedAt();
      } catch {
        statusEl.textContent = i18n.error ?? '';
        statusEl.className = 'text-sm text-error';
      } finally {
        submitBtn.disabled = false;
        submitLabel.textContent = i18n.submit ?? '';
      }
    });
  }
</script>
