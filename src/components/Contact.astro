---
import { useTranslations, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const contact = t('contact');
const form = contact.form;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const field =
  'mt-3 w-full border-0 border-b border-white/20 bg-transparent pb-3 text-sm text-paper placeholder:text-paper/30 focus:border-copper focus:outline-none';
---

<section id="contact" class="relative scroll-mt-24 overflow-hidden bg-black">
  <!--
    Vidéo d'ambiance (placeholder libre de droits — Pexels).
    À remplacer par les images tournées par David : voir README.md.
  -->
  <video
    class="absolute inset-0 h-full w-full object-cover opacity-20"
    autoplay
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
  >
    <source src={`${base}/videos/atelier-poncage.mp4`} type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-gradient-to-b from-black via-black/85 to-black" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[1600px] px-6 py-10 sm:px-10 sm:py-16">
    <div class="flex items-center gap-4">
      <span class="h-px w-12 bg-copper" aria-hidden="true"></span>
      <span class="text-[0.6rem] font-medium tracked text-copper-light">05 — {contact.kicker}</span>
    </div>

    <div class="mt-8 grid gap-10 sm:mt-12 sm:gap-16 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 class="font-display text-4xl leading-[1.02] font-medium tracking-[-0.03em] whitespace-pre-line text-paper sm:text-5xl lg:text-6xl">
          {contact.title}
        </h2>
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-paper/60 sm:text-base">{contact.lead}</p>

        <dl class="mt-8 sm:mt-12">
          <div class="border-t border-white/10 py-5">
            <dt class="text-[0.55rem] font-medium tracked text-paper/40">{form.email}</dt>
            <dd class="mt-2">
              <a href={`mailto:${contact.email}`} class="font-display text-base text-paper transition hover:text-copper-light">
                {contact.email}
              </a>
            </dd>
          </div>
          <div class="border-t border-white/10 py-5">
            <dt class="text-[0.55rem] font-medium tracked text-paper/40">{lang === 'fr' ? 'Téléphone' : 'Phone'}</dt>
            <dd class="mt-2">
              <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="font-display text-base text-paper transition hover:text-copper-light">
                {contact.phone}
              </a>
            </dd>
          </div>
          <div class="border-t border-b border-white/10 py-5">
            <dt class="text-[0.55rem] font-medium tracked text-paper/40">{lang === 'fr' ? 'Atelier' : 'Workshop'}</dt>
            <dd class="mt-2 font-display text-base text-paper">{contact.location}</dd>
          </div>
        </dl>

        <a
          href="https://www.instagram.com/artdesignbyhirzel/"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-3 text-[0.6rem] font-medium tracked text-paper/60 transition hover:text-copper-light"
        >
          <Icon name="instagram" class="h-4 w-4" />
          @artdesignbyhirzel
        </a>

        <p class="mt-10 text-[0.65rem] text-paper/25">{contact.emailNote} · {contact.phoneNote}</p>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <form
          id="contact-form"
          novalidate
          data-base={base}
          data-i18n={JSON.stringify({
            submitting: form.submitting,
            submit: form.submit,
            success: form.success,
            error: form.error,
            errorValidation: form.errorValidation,
          })}
        >
          <div class="grid gap-9 sm:grid-cols-2">
            <div>
              <label for="name" class="text-[0.55rem] font-medium tracked text-paper/40">{form.name}</label>
              <input type="text" id="name" name="name" required autocomplete="name" placeholder={form.namePlaceholder} class={field} />
            </div>
            <div>
              <label for="email" class="text-[0.55rem] font-medium tracked text-paper/40">{form.email}</label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder={form.emailPlaceholder} class={field} />
            </div>
            <div class="sm:col-span-2">
              <label for="subject" class="text-[0.55rem] font-medium tracked text-paper/40">{form.subject}</label>
              <input type="text" id="subject" name="subject" autocomplete="off" placeholder={form.subjectPlaceholder} class={field} />
            </div>
            <div class="sm:col-span-2">
              <label for="message" class="text-[0.55rem] font-medium tracked text-paper/40">{form.message}</label>
              <textarea id="message" name="message" required rows="4" placeholder={form.messagePlaceholder} class={field + ' resize-y'}></textarea>
            </div>
          </div>

          <!-- Piège à robots : champ invisible pour les humains, laissé vide -->
          <div class="hidden" aria-hidden="true">
            <label for="company">Company</label>
            <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="rendered_at" value="" id="rendered_at" />

          <label class="mt-8 flex items-start gap-3 text-[0.7rem] leading-relaxed text-paper/45">
            <input type="checkbox" name="consent" required class="mt-0.5 h-3.5 w-3.5 shrink-0 border-white/25 bg-transparent text-copper focus:ring-copper/40" />
            <span>{form.consent}</span>
          </label>

          <div class="mt-10 flex flex-wrap items-center gap-6">
            <button
              type="submit"
              id="contact-submit"
              class="border border-paper/80 px-9 py-4 text-[0.65rem] font-medium tracked text-paper transition hover:border-copper hover:bg-copper hover:text-black disabled:cursor-not-allowed disabled:opacity-40"
            >
              <span id="contact-submit-label">{form.submit}</span>
            </button>
            <p id="contact-status" role="status" aria-live="polite" class="text-sm"></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const formEl = document.getElementById('contact-form');
  const statusEl = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit');
  const submitLabel = document.getElementById('contact-submit-label');
  const renderedAt = document.getElementById('rendered_at');

  const stampRenderedAt = () => {
    if (renderedAt instanceof HTMLInputElement) renderedAt.value = String(Date.now());
  };

  if (
    formEl instanceof HTMLFormElement &&
    statusEl &&
    submitBtn instanceof HTMLButtonElement &&
    submitLabel
  ) {
    const i18n = JSON.parse(formEl.dataset.i18n || '{}');
    stampRenderedAt();

    formEl.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!formEl.checkValidity()) {
        formEl.reportValidity();
        statusEl.textContent = i18n.errorValidation ?? '';
        statusEl.className = 'text-sm text-error';
        return;
      }

      submitBtn.disabled = true;
      submitLabel.textContent = i18n.submitting ?? '';
      statusEl.textContent = '';
      statusEl.className = 'text-sm text-ink-faint';

      try {
        const formData = new FormData(formEl);
        const apiBase = formEl.dataset.base || '';
        const response = await fetch(`${apiBase}/api/contact.php`, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || 'request_failed');
        }

        statusEl.textContent = i18n.success ?? '';
        statusEl.className = 'text-sm text-success';
        formEl.reset();
        stampRenderedAt();
      } catch {
        statusEl.textContent = i18n.error ?? '';
        statusEl.className = 'text-sm text-error';
      } finally {
        submitBtn.disabled = false;
        submitLabel.textContent = i18n.submit ?? '';
      }
    });
  }
</script>
