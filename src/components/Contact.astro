---
import { useTranslations, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const contact = t('contact');
const form = contact.form;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="contact" class="scroll-mt-24">
  <div class="mx-auto grid max-w-[1400px] lg:grid-cols-2">
    <!-- Coordonnées -->
    <div class="border-b border-ink bg-ink px-5 py-16 text-paper sm:px-8 sm:py-20 lg:border-r lg:border-b-0">
      <span class="text-xs font-semibold tracking-[0.14em] text-copper-light uppercase">05 — {contact.kicker}</span>
      <h2 class="mt-3 font-display text-3xl leading-[1.02] font-extrabold tracking-tight sm:text-4xl">{contact.title}</h2>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-paper/70 sm:text-base">{contact.lead}</p>

      <ul class="mt-10 divide-y divide-white/15 border-t border-white/15">
        <li class="flex items-center justify-between gap-4 py-4">
          <span class="text-xs font-semibold tracking-wide text-paper/50 uppercase">{form.email}</span>
          <a href={`mailto:${contact.email}`} class="text-sm font-semibold text-paper hover:text-copper-light">{contact.email}</a>
        </li>
        <li class="flex items-center justify-between gap-4 py-4">
          <span class="text-xs font-semibold tracking-wide text-paper/50 uppercase">{lang === 'fr' ? 'Téléphone' : 'Phone'}</span>
          <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="text-sm font-semibold text-paper hover:text-copper-light">{contact.phone}</a>
        </li>
        <li class="flex items-center justify-between gap-4 py-4">
          <span class="text-xs font-semibold tracking-wide text-paper/50 uppercase">{lang === 'fr' ? 'Atelier' : 'Workshop'}</span>
          <span class="text-sm font-semibold text-paper">{contact.location}</span>
        </li>
        <li class="flex items-center justify-between gap-4 py-4">
          <span class="text-xs font-semibold tracking-wide text-paper/50 uppercase">{contact.social}</span>
          <a
            href="https://www.instagram.com/artdesignbyhirzel/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 text-sm font-semibold text-paper hover:text-copper-light"
          >
            <Icon name="instagram" class="h-4 w-4" />
            @artdesignbyhirzel
          </a>
        </li>
      </ul>

      <p class="mt-8 text-xs text-paper/40">{contact.emailNote} · {contact.phoneNote}</p>
    </div>

    <!-- Formulaire -->
    <div class="border-b border-ink px-5 py-16 sm:px-8 sm:py-20">
      <form
        id="contact-form"
        novalidate
        data-base={base}
        data-i18n={JSON.stringify({
          submitting: form.submitting,
          submit: form.submit,
          success: form.success,
          error: form.error,
          errorValidation: form.errorValidation,
        })}
      >
        <div class="grid gap-7 sm:grid-cols-2">
          <div class="sm:col-span-1">
            <label for="name" class="text-xs font-semibold tracking-wide text-ink-faint uppercase">{form.name}</label>
            <input
              type="text" id="name" name="name" required autocomplete="name"
              placeholder={form.namePlaceholder}
              class="mt-2 w-full border-b border-ink bg-transparent py-2 text-sm text-ink placeholder:text-ink-faint focus:border-copper focus:outline-none"
            />
          </div>
          <div class="sm:col-span-1">
            <label for="email" class="text-xs font-semibold tracking-wide text-ink-faint uppercase">{form.email}</label>
            <input
              type="email" id="email" name="email" required autocomplete="email"
              placeholder={form.emailPlaceholder}
              class="mt-2 w-full border-b border-ink bg-transparent py-2 text-sm text-ink placeholder:text-ink-faint focus:border-copper focus:outline-none"
            />
          </div>
          <div class="sm:col-span-2">
            <label for="subject" class="text-xs font-semibold tracking-wide text-ink-faint uppercase">{form.subject}</label>
            <input
              type="text" id="subject" name="subject" autocomplete="off"
              placeholder={form.subjectPlaceholder}
              class="mt-2 w-full border-b border-ink bg-transparent py-2 text-sm text-ink placeholder:text-ink-faint focus:border-copper focus:outline-none"
            />
          </div>
          <div class="sm:col-span-2">
            <label for="message" class="text-xs font-semibold tracking-wide text-ink-faint uppercase">{form.message}</label>
            <textarea
              id="message" name="message" required rows="4"
              placeholder={form.messagePlaceholder}
              class="mt-2 w-full resize-y border-b border-ink bg-transparent py-2 text-sm text-ink placeholder:text-ink-faint focus:border-copper focus:outline-none"
            ></textarea>
          </div>
        </div>

        <!-- Piège à robots : champ invisible pour les humains, laissé vide -->
        <div class="hidden" aria-hidden="true">
          <label for="company">Company</label>
          <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="rendered_at" value="" id="rendered_at" />

        <label class="mt-6 flex items-start gap-2.5 text-xs text-ink-faint">
          <input type="checkbox" name="consent" required class="mt-0.5 h-4 w-4 shrink-0 border-border text-copper focus:ring-copper/30" />
          <span>{form.consent}</span>
        </label>

        <div class="mt-7 flex flex-wrap items-center gap-5">
          <button
            type="submit"
            id="contact-submit"
            class="inline-flex items-center gap-2 border border-ink bg-ink px-6 py-3.5 text-xs font-semibold tracking-[0.12em] text-paper uppercase transition hover:border-copper hover:bg-copper disabled:cursor-not-allowed disabled:opacity-60"
          >
            <span id="contact-submit-label">{form.submit}</span>
          </button>
          <p id="contact-status" role="status" aria-live="polite" class="text-sm"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const formEl = document.getElementById('contact-form');
  const statusEl = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit');
  const submitLabel = document.getElementById('contact-submit-label');
  const renderedAt = document.getElementById('rendered_at');

  const stampRenderedAt = () => {
    if (renderedAt instanceof HTMLInputElement) renderedAt.value = String(Date.now());
  };

  if (
    formEl instanceof HTMLFormElement &&
    statusEl &&
    submitBtn instanceof HTMLButtonElement &&
    submitLabel
  ) {
    const i18n = JSON.parse(formEl.dataset.i18n || '{}');
    stampRenderedAt();

    formEl.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!formEl.checkValidity()) {
        formEl.reportValidity();
        statusEl.textContent = i18n.errorValidation ?? '';
        statusEl.className = 'text-sm text-error';
        return;
      }

      submitBtn.disabled = true;
      submitLabel.textContent = i18n.submitting ?? '';
      statusEl.textContent = '';
      statusEl.className = 'text-sm text-ink-faint';

      try {
        const formData = new FormData(formEl);
        const apiBase = formEl.dataset.base || '';
        const response = await fetch(`${apiBase}/api/contact.php`, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          throw new Error(result?.message || 'request_failed');
        }

        statusEl.textContent = i18n.success ?? '';
        statusEl.className = 'text-sm text-success';
        formEl.reset();
        stampRenderedAt();
      } catch {
        statusEl.textContent = i18n.error ?? '';
        statusEl.className = 'text-sm text-error';
      } finally {
        submitBtn.disabled = false;
        submitLabel.textContent = i18n.submit ?? '';
      }
    });
  }
</script>
