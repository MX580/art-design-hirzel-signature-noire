---
import { Image } from 'astro:assets';
import heroMain from '../assets/gallery/table-bois-metal.jpg';
import { useTranslations, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const hero = t('hero');
const prefix = lang === 'en' ? '/en' : '';
---

<section class="border-b border-ink">
  <div class="mx-auto max-w-[1400px] px-5 pt-14 pb-12 sm:px-8 sm:pt-20 sm:pb-16">
    <div class="flex items-center gap-3">
      <span class="h-2 w-2 shrink-0 bg-copper" aria-hidden="true"></span>
      <span class="text-xs font-semibold tracking-[0.14em] text-ink-soft uppercase">{hero.kicker}</span>
    </div>

    <div class="mt-6 grid gap-10 lg:grid-cols-12 lg:gap-8">
      <h1 class="font-display text-[2.6rem] leading-[0.96] font-extrabold tracking-tight text-ink sm:text-6xl lg:col-span-8 lg:text-[4.75rem]">
        {hero.title}
      </h1>

      <div class="flex flex-col gap-6 lg:col-span-4 lg:justify-end lg:pb-2">
        <p class="border-l-2 border-copper pl-4 font-display text-lg font-medium text-ink-soft italic">
          {hero.quote}
        </p>
        <p class="text-base leading-relaxed text-ink-soft">
          {hero.lead}
        </p>
      </div>
    </div>

    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a
        href={`${prefix}/#realisations`}
        class="group inline-flex items-center gap-2 border border-ink bg-ink px-6 py-3.5 text-xs font-semibold tracking-[0.12em] text-paper uppercase transition hover:border-copper hover:bg-copper"
      >
        {hero.ctaPrimary}
        <Icon name="arrow-right" class="h-3.5 w-3.5 transition group-hover:translate-x-0.5" />
      </a>
      <a
        href={`${prefix}/#contact`}
        class="inline-flex items-center gap-2 border border-ink px-6 py-3.5 text-xs font-semibold tracking-[0.12em] text-ink uppercase transition hover:border-copper hover:text-copper"
      >
        {hero.ctaSecondary}
      </a>
    </div>
  </div>

  <div class="relative mx-auto max-w-[1400px] border-t border-ink">
    <div class="relative aspect-[16/8] w-full overflow-hidden sm:aspect-[16/6]">
      <Image
        src={heroMain}
        alt={t('gallery').items[0].alt}
        class="h-full w-full object-cover grayscale-[35%] contrast-[1.08]"
        width={1400}
        height={600}
        loading="eager"
      />
    </div>
    <span class="absolute bottom-0 left-0 border-t border-r border-ink bg-cream px-3 py-1.5 font-mono text-[0.65rem] font-medium tracking-wider text-ink uppercase">
      Fig. 01 — {lang === 'fr' ? 'Atelier' : 'Workshop'}
    </span>
    <span class="absolute top-0 right-0 hidden border-b border-l border-ink bg-cream px-4 py-2.5 sm:flex sm:items-center sm:gap-2">
      <Icon name="layers" class="h-3.5 w-3.5 text-copper" />
      <span class="text-xs font-semibold tracking-[0.1em] text-ink uppercase">{hero.materialsBadge}</span>
    </span>
  </div>
</section>
