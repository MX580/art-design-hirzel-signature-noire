---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const hero = t('hero');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = base + (lang === 'en' ? '/en' : '');
---

<section class="relative flex min-h-[100svh] items-end overflow-hidden bg-black">
  <!--
    Vidéo d'ambiance plein cadre (placeholder libre de droits — Pexels).
    À remplacer par les images tournées par David : voir README.md.
  -->
  <video
    class="absolute inset-0 h-full w-full object-cover opacity-90"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={`${base}/og-image.jpg`}
    aria-hidden="true"
  >
    <source src={`${base}/videos/atelier-rabot.mp4`} type="video/mp4" />
  </video>

  <!-- Voiles sombres : lisibilité et profondeur cinématographique -->
  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/45 to-black/25" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/25 to-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-[1600px] px-6 pb-20 sm:px-10 sm:pb-28">
    <div class="animate-fade-up max-w-3xl">
      <div class="flex items-center gap-4">
        <span class="h-px w-12 bg-copper" aria-hidden="true"></span>
        <span class="text-[0.6rem] font-medium tracked text-copper-light sm:text-[0.7rem]">{hero.kicker}</span>
      </div>

      <h1 class="mt-8 font-display text-[2.75rem] leading-[0.92] font-medium tracking-[-0.03em] text-paper sm:text-7xl lg:text-[5.5rem]">
        {hero.title}
      </h1>

      <p class="mt-8 max-w-xl text-base leading-relaxed text-paper/70 sm:text-lg">
        {hero.lead}
      </p>

      <div class="mt-12 flex flex-wrap items-center gap-5">
        <a
          href={`${prefix}/#realisations`}
          class="border border-paper/80 px-9 py-4 text-[0.65rem] font-medium tracked text-paper transition hover:border-copper hover:bg-copper hover:text-black"
        >
          {hero.ctaPrimary}
        </a>
        <a
          href={`${prefix}/#contact`}
          class="border-b border-transparent pb-1 text-[0.65rem] font-medium tracked text-paper/70 transition hover:border-copper hover:text-copper-light"
        >
          {hero.ctaSecondary}
        </a>
      </div>
    </div>
  </div>

  <p class="absolute right-10 bottom-24 hidden max-w-[15rem] text-right text-xs leading-relaxed text-paper/45 italic lg:block">
    {hero.quote}
  </p>
</section>
