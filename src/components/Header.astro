---
import { useTranslations, getAlternateLangPath, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  altPath?: string;
}

const { lang, altPath } = Astro.props;
const t = useTranslations(lang);
const nav = t('nav');
const common = t('common');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = base + (lang === 'en' ? '/en' : '');
const links = [
  { href: `${prefix}/#a-propos`, label: nav.about },
  { href: `${prefix}/#savoir-faire`, label: nav.skills },
  { href: `${prefix}/#realisations`, label: nav.gallery },
  { href: `${prefix}/#contact`, label: nav.contact },
];

const altHref = altPath ?? getAlternateLangPath(Astro.url, lang === 'fr' ? 'en' : 'fr');
---

<header class="sticky top-0 z-50 border-b border-ink bg-cream/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a href={`${prefix}/`} class="shrink-0">
      <span class="font-display text-base font-extrabold tracking-tight text-ink sm:text-lg">
        ART DESIGN <span class="font-normal text-ink-soft">BY HIRZEL</span>
      </span>
    </a>

    <nav class="hidden items-center gap-9 lg:flex" aria-label={common.mainNav}>
      {links.map((link, i) => (
        <a href={link.href} class="group flex items-center gap-2 text-xs font-semibold tracking-[0.12em] text-ink uppercase">
          <span class="text-copper">0{i + 1}</span>
          <span class="border-b border-transparent group-hover:border-ink">{link.label}</span>
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-6 lg:flex">
      <a
        href={altHref}
        class="text-xs font-semibold tracking-[0.12em] text-ink-soft uppercase hover:text-ink"
        aria-label={common.langSwitchLabel}
      >
        {common.langSwitch}
      </a>
      <a
        href="https://www.instagram.com/artdesignbyhirzel/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-ink-soft transition hover:text-copper"
        aria-label={common.instagramNewTab}
      >
        <Icon name="instagram" class="h-5 w-5" />
      </a>
      <a
        href={`${prefix}/#contact`}
        class="border border-ink bg-ink px-5 py-2.5 text-xs font-semibold tracking-[0.12em] text-paper uppercase transition hover:border-copper hover:bg-copper"
      >
        {nav.cta}
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-9 w-9 items-center justify-center text-ink lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={common.openMenu}
    >
      <Icon name="menu" class="h-5 w-5" id="icon-open" />
      <Icon name="close" class="hidden h-5 w-5" id="icon-close" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-ink bg-cream lg:hidden">
    <nav class="flex flex-col gap-1 px-5 py-4" aria-label={common.mobileNav}>
      {links.map((link, i) => (
        <a href={link.href} class="flex items-center gap-3 border-b border-border py-3 text-sm font-semibold tracking-wide text-ink uppercase">
          <span class="text-copper">0{i + 1}</span>
          {link.label}
        </a>
      ))}
      <div class="mt-3 flex items-center gap-5">
        <a href={altHref} class="text-xs font-semibold tracking-[0.12em] text-ink-soft uppercase">
          {common.langSwitch}
        </a>
        <a
          href="https://www.instagram.com/artdesignbyhirzel/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-soft"
          aria-label={common.instagramNewTab}
        >
          <Icon name="instagram" class="h-5 w-5" />
        </a>
      </div>
      <a
        href={`${prefix}/#contact`}
        class="mt-4 border border-ink bg-ink px-5 py-3 text-center text-xs font-semibold tracking-[0.12em] text-paper uppercase"
      >
        {nav.cta}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
