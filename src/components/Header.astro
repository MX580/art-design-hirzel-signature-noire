---
import { useTranslations, getAlternateLangPath, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  altPath?: string;
}

const { lang, altPath } = Astro.props;
const t = useTranslations(lang);
const nav = t('nav');
const common = t('common');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = base + (lang === 'en' ? '/en' : '');
const links = [
  { href: `${prefix}/#a-propos`, label: nav.about },
  { href: `${prefix}/#savoir-faire`, label: nav.skills },
  { href: `${prefix}/#realisations`, label: nav.gallery },
  { href: `${prefix}/#contact`, label: nav.contact },
];

const altHref = altPath ?? getAlternateLangPath(Astro.url, lang === 'fr' ? 'en' : 'fr');
---

<header class="fixed top-0 right-[var(--band)] left-[var(--band)] z-50 bg-gradient-to-b from-black/85 to-transparent">
  <div class="relative mx-auto flex max-w-[1600px] items-center justify-between px-2 py-6 sm:px-10">
    <button
      id="menu-toggle"
      type="button"
      class="flex items-center gap-3 text-paper transition hover:text-copper-light"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={common.openMenu}
    >
      <span id="icon-open" class="flex flex-col gap-[5px]">
        <span class="block h-px w-6 bg-current"></span>
        <span class="block h-px w-6 bg-current"></span>
      </span>
      <Icon name="close" class="hidden h-5 w-5" id="icon-close" />
    </button>

    <a
      href={`${prefix}/`}
      class="absolute left-1/2 -translate-x-1/2 text-center font-display text-base leading-[1.15] font-semibold tracking-[0.12em] text-paper uppercase sm:text-2xl sm:leading-none sm:tracking-[0.14em] sm:whitespace-nowrap lg:text-4xl"
    >
      <span class="block sm:inline">Art Design</span>{' '}
      <span class="block sm:inline">by Hirzel</span>
    </a>

    <div class="flex items-center gap-4 sm:gap-6">
      <a
        href={altHref}
        class="text-[0.65rem] font-medium tracked text-paper/70 transition hover:text-copper-light"
        aria-label={common.langSwitchLabel}
      >
        {common.langSwitch}
      </a>
      <a
        href="https://www.instagram.com/artdesignbyhirzel/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-paper/70 transition hover:text-copper-light"
        aria-label={common.instagramNewTab}
      >
        <Icon name="instagram" class="h-4 w-4" />
      </a>
    </div>
  </div>

  <!-- Panneau de navigation plein écran -->
  <div id="mobile-menu" class="hidden border-t border-white/10 bg-black/95 backdrop-blur-sm">
    <nav class="mx-auto flex max-w-[1600px] flex-col px-6 py-10 sm:px-10" aria-label={common.mainNav}>
      {links.map((link, i) => (
        <a
          href={link.href}
          class="group flex items-baseline gap-5 border-b border-white/10 py-5 text-paper transition hover:text-copper-light"
        >
          <span class="font-display text-[0.6rem] tracked text-copper">{String(i + 1).padStart(2, '0')}</span>
          <span class="font-display text-2xl font-medium tracking-tight sm:text-3xl">{link.label}</span>
        </a>
      ))}
      <a
        href={`${prefix}/#contact`}
        class="mt-8 self-start border border-white/25 px-8 py-4 text-[0.65rem] font-medium tracked text-paper transition hover:border-copper hover:text-copper-light"
      >
        {nav.cta}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
