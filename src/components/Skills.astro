---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const skills = t('skills');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="savoir-faire" class="scroll-mt-24 bg-black">
  <div class="mx-auto max-w-[1600px] px-6 py-10 sm:px-10 sm:py-16">
    <div class="grid gap-10 sm:gap-14 lg:grid-cols-12 lg:gap-16">
      <!-- Colonne intitulé + vidéo, collante au scroll -->
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-32">
          <div class="flex items-center gap-4">
            <span class="h-px w-12 bg-copper" aria-hidden="true"></span>
            <span class="text-[0.6rem] font-medium tracked text-copper-light">03 — {skills.kicker}</span>
          </div>
          <h2 class="mt-8 font-display text-4xl leading-[1.02] font-medium tracking-[-0.03em] text-paper sm:text-5xl lg:text-6xl">
            {skills.title}
          </h2>
          <p class="mt-6 max-w-sm text-base leading-relaxed text-paper/60">
            {skills.lead}
          </p>
          <div class="mt-8 aspect-[4/3] w-full overflow-hidden sm:mt-10">
            <video
              class="h-full w-full object-cover opacity-80"
              autoplay
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
            >
              <source src={`${base}/videos/atelier-outils.mp4`} type="video/mp4" />
            </video>
          </div>
        </div>
      </div>

      <!-- Liste des savoir-faire -->
      <div class="lg:col-span-6 lg:col-start-7">
        {skills.items.map((item, i) => (
          <div class="group border-t border-white/10 py-6 last:border-b sm:py-10">
            <div class="flex items-baseline gap-6">
              <span class="font-display text-[0.6rem] tracked text-copper">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-display text-xl leading-tight font-medium tracking-tight text-paper transition group-hover:text-copper-light sm:text-2xl">
                  {item.title}
                </h3>
                <p class="mt-3 max-w-md text-sm leading-relaxed text-paper/55">
                  {item.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
