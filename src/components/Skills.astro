---
import { useTranslations, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const skills = t('skills');

const icons = ['table', 'board', 'cabinet', 'flame', 'layers', 'sparkles'] as const;
---

<section id="savoir-faire" class="scroll-mt-24 border-b border-ink">
  <div class="mx-auto max-w-[1400px] px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <span class="text-xs font-semibold tracking-[0.14em] text-copper uppercase">03 — {skills.kicker}</span>
        <h2 class="mt-3 font-display text-3xl leading-[1.02] font-extrabold tracking-tight text-ink sm:text-4xl">
          {skills.title}
        </h2>
        <p class="mt-4 max-w-sm text-base leading-relaxed text-ink-soft">
          {skills.lead}
        </p>
      </div>

      <div class="border-t border-ink lg:col-span-8">
        {skills.items.map((item, i) => (
          <div class="group grid grid-cols-[3.5rem_2.5rem_1fr] items-start gap-4 border-b border-border py-6 sm:grid-cols-[3.5rem_2.5rem_1fr_14rem] sm:items-center">
            <span class="font-display text-sm font-semibold text-ink-faint">{String(i + 1).padStart(2, '0')}</span>
            <Icon name={icons[i]} class="h-5 w-5 text-copper" />
            <h3 class="font-display text-lg font-bold tracking-tight text-ink sm:text-xl">
              {item.title}
            </h3>
            <p class="col-span-3 text-sm leading-relaxed text-ink-soft sm:col-span-1">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
