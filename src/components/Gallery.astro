---
import { Image } from 'astro:assets';
import tableBoisMetal from '../assets/gallery/table-bois-metal.jpg';
import plancheEndGrain from '../assets/gallery/planche-end-grain.jpg';
import planchesDuo from '../assets/gallery/planches-duo.jpg';
import braseroFeu from '../assets/gallery/brasero-feu.jpg';
import structureAcier from '../assets/gallery/structure-acier-detail.jpg';
import mainsFinition from '../assets/about/mains-finition.jpg';
import { useTranslations, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const gallery = t('gallery');

// Dimensions cible par image (reflète le cadrage réel de chaque photo :
// la table bois/métal a été recadrée en format paysage 4:3, les autres
// gardent leur cadrage portrait d'origine — la variété de hauteurs anime
// naturellement la grille en mosaïque ci-dessous).
const images = [
  { src: tableBoisMetal, width: 640, height: 480 },
  { src: plancheEndGrain, width: 640, height: 480 },
  { src: planchesDuo, width: 640, height: 800 },
  { src: braseroFeu, width: 640, height: 800 },
  { src: structureAcier, width: 640, height: 720 },
  { src: mainsFinition, width: 640, height: 800 },
];
---

<section id="realisations" class="scroll-mt-24 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <span class="inline-flex items-center rounded-full bg-copper-tint px-4 py-1.5 text-xs font-semibold tracking-wide text-copper-dark uppercase">
          {gallery.kicker}
        </span>
        <h2 class="mt-5 font-display text-3xl font-semibold text-ink sm:text-4xl">
          {gallery.title}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-soft sm:text-lg">
          {gallery.lead}
        </p>
      </div>

      <a
        href="https://www.instagram.com/artdesignbyhirzel/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-2 self-start rounded-full border border-ink/15 bg-surface px-5 py-3 text-sm font-semibold text-ink shadow-card transition hover:border-copper hover:text-copper"
      >
        <Icon name="instagram" class="h-4 w-4" />
        {gallery.instagramCta}
        <Icon name="external-link" class="h-3.5 w-3.5 opacity-60" />
      </a>
    </div>

    <div class="mt-12 columns-2 gap-5 md:columns-3 [&>*]:mb-5">
      {gallery.items.map((item, i) => (
        <figure class="group relative overflow-hidden rounded-xl shadow-card ring-1 ring-ink/5 break-inside-avoid">
          <Image
            src={images[i].src}
            alt={item.alt}
            class="w-full object-cover transition duration-500 group-hover:scale-[1.04]"
            width={images[i].width}
            height={images[i].height}
            loading={i < 2 ? 'eager' : 'lazy'}
          />
          <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-steel/85 via-steel/10 to-transparent p-4 pt-10">
            <figcaption class="text-sm font-medium text-cream">{item.caption}</figcaption>
          </div>
        </figure>
      ))}
    </div>
  </div>
</section>
