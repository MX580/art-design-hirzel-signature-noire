---
import { Image } from 'astro:assets';
import tableBoisMetal from '../assets/gallery/table-bois-metal.jpg';
import plancheEndGrain from '../assets/gallery/planche-end-grain.jpg';
import planchesDuo from '../assets/gallery/planches-duo.jpg';
import braseroFeu from '../assets/gallery/brasero-feu.jpg';
import structureAcier from '../assets/gallery/structure-acier-detail.jpg';
import mainsFinition from '../assets/about/mains-finition.jpg';
import { useTranslations, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const gallery = t('gallery');

const images = [tableBoisMetal, plancheEndGrain, planchesDuo, braseroFeu, structureAcier, mainsFinition];
---

<section id="realisations" class="scroll-mt-24 border-b border-ink">
  <div class="mx-auto max-w-[1400px] px-5 py-16 sm:px-8 sm:py-20">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-xl">
        <span class="text-xs font-semibold tracking-[0.14em] text-copper uppercase">04 — {gallery.kicker}</span>
        <h2 class="mt-3 font-display text-3xl leading-[1.02] font-extrabold tracking-tight text-ink sm:text-4xl">
          {gallery.title}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-soft">
          {gallery.lead}
        </p>
      </div>

      <a
        href="https://www.instagram.com/artdesignbyhirzel/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-2 self-start border border-ink px-5 py-3 text-xs font-semibold tracking-[0.1em] text-ink uppercase transition hover:border-copper hover:text-copper"
      >
        <Icon name="instagram" class="h-4 w-4" />
        {gallery.instagramCta}
      </a>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 border-t border-ink pt-10 sm:grid-cols-3">
      {gallery.items.map((item, i) => (
        <figure>
          <div class="relative aspect-[4/5] w-full overflow-hidden border border-border">
            <Image
              src={images[i]}
              alt={item.alt}
              class="h-full w-full object-cover grayscale-[35%] contrast-[1.08] transition duration-500 hover:grayscale-0"
              width={480}
              height={600}
              loading={i < 3 ? 'eager' : 'lazy'}
            />
          </div>
          <figcaption class="mt-3 flex items-baseline gap-2">
            <span class="font-mono text-xs text-copper">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-xs font-medium tracking-wide text-ink-soft uppercase">{item.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
