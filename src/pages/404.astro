---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout lang="fr" title="Page introuvable — Art Design by Hirzel">
  <section class="flex min-h-[85svh] items-center justify-center px-6 text-center sm:px-10">
    <div class="max-w-lg">
      <span class="text-[0.6rem] font-medium tracked text-copper">Erreur 404</span>
      <h1 class="mt-5 font-display text-4xl font-medium tracking-[-0.03em] text-paper sm:text-6xl">Page introuvable</h1>
      <p class="mt-6 text-base leading-relaxed text-paper/55">
        Cette page n'existe pas ou plus.
        <span class="mt-1 block text-sm text-paper/35">(This page could not be found.)</span>
      </p>
      <div class="mt-12 flex flex-wrap items-center justify-center gap-5">
        <a href={`${base}/`} class="border border-paper/80 px-9 py-4 text-[0.65rem] font-medium tracked text-paper transition hover:border-copper hover:bg-copper hover:text-black">
          Retour à l'accueil
        </a>
        <a href={`${base}/en/`} class="border-b border-transparent pb-1 text-[0.65rem] font-medium tracked text-paper/60 transition hover:border-copper hover:text-copper-light">
          English homepage
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
