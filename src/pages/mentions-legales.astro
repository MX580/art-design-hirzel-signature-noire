---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalContent from '../components/LegalContent.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('fr');
const legal = t('legalNotice');
---

<BaseLayout lang="fr" title={`${legal.title} — Art Design by Hirzel`} description={legal.intro} altPath="/en/legal-notice">
  <LegalContent title={legal.title} updated={legal.updated} intro={legal.intro} sections={legal.sections} />
</BaseLayout>
