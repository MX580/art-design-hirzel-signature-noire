---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalContent from '../components/LegalContent.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('fr');
const privacy = t('privacy');
---

<BaseLayout lang="fr" title={`${privacy.title} — Art Design by Hirzel`} description={privacy.intro} altPath="/en/privacy-policy">
  <LegalContent title={privacy.title} updated={privacy.updated} intro={privacy.intro} sections={privacy.sections} />
</BaseLayout>
